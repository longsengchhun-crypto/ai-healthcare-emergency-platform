# Copy to .env and fill in. NEVER commit .env.
DB_PASSWORD=change-me-strong-password
# 32+ random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:8081

# Development/demo only. Leave SEED_DEMO_DATA=false everywhere else.
SEED_DEMO_DATA=false
SEED_DEMO_PASSWORD=
DEV_LOG_RESET_TOKENS=false

# AI: only "deterministic-demo" ships in this repository (rule based, not a language model).
AI_PROVIDER=deterministic-demo
AI_API_KEY=
# anthropic = Claude on top of the safety rules (needs AI_API_KEY); deterministic-demo = rules only
AI_MODEL=claude-opus-5-5
AI_TIMEOUT_SECONDS=20
AI_MAX_RETRIES=2
AI_RATE_LIMIT_PER_MINUTE=10

# Optional channels - see docs/INTEGRATIONS.md. Leave empty to disable.
FCM_SERVICE_ACCOUNT_FILE=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=

# Per-IP limit on login/register/refresh/reset requests (default 10). FORWARD_HEADERS=framework is only safe
# behind a trusted reverse proxy that sets X-Forwarded-For; never enable it on a directly exposed server.
RATE_LIMIT_AUTH_PER_MINUTE=10
FORWARD_HEADERS=none
